{
  "name": "typebeatos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:check": "tsx scripts/ui-quality-check.ts",
    "ui:check:strict": "tsx scripts/ui-quality-check.ts --strict",
    "ui:routes": "tsx scripts/ui-route-scorecard-check.ts",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:validate-postgres": "DATABASE_URL=postgresql://ci:ci@localhost:5432/ci DIRECT_URL=postgresql://ci:ci@localhost:5432/ci prisma validate --schema=prisma/schema.postgres.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "db:migrate:status": "prisma migrate status --schema=prisma/schema.postgres.prisma",
    "db:verify:postgres": "npm run db:generate:postgres && tsx scripts/verify-postgres.ts",
    "seed:dev": "CONFIRM_SEED=yes tsx scripts/seed-dev.ts",
    "cleanup:dev": "CONFIRM_CLEANUP=yes tsx scripts/cleanup-test-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.20",
    "ffmpeg-static": "^5.3.0",
    "fft.js": "^4.0.4",
    "lucide-react": "^1.21.0",
    "music-tempo": "^1.0.3",
    "next": "^15.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "prisma": "^6.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
