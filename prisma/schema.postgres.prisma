// Production schema for Neon PostgreSQL. Keep its models in lockstep with
// `schema.prisma`, which remains the local SQLite development schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Auth (Better-Auth compatible)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified Boolean   @default(false)
  passwordHash  String    @default("") // legacy, retired once all sessions migrate
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  profile      Profile?
  beats        Beat[]
  youtube      YouTubeAccount?
  subscription Subscription?
}

// ============================================================
// Billing (Stripe)
// ============================================================
model Subscription {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("free") // free | pro | serious
  status               String    @default("inactive") // active | trialing | past_due | canceled | inactive
  interval             String    @default("month") // month | year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================================
// Producer data
// ============================================================

model YouTubeAccount {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  channelId    String   @default("")
  channelTitle String   @default("")
  createdAt    DateTime @default(now())
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("producer") // "producer" | "beta"
  referrer  String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Profile {
  userId            String @id
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  producerName      String @default("")
  youtubeUrl        String @default("")
  storeUrl          String @default("")
  instagramUrl      String @default("")
  contactEmail      String @default("")
  licenseText       String @default("")
  descriptionFooter String @default("")
  scheduleDays      String @default("1,3,5")
  scheduleTime      String @default("18:00")
  timezone          String @default("")
}

model Beat {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetArtist    String
  secondaryArtist String   @default("")
  genre           String   @default("")
  mood            String   @default("")
  bpm             Int?
  key             String   @default("")
  storeLink       String   @default("")
  licensePrice    String   @default("")
  exclusivePrice  String   @default("")
  audioPath       String   @default("")
  createdAt       DateTime @default(now())
  package         Package?

  @@index([userId, createdAt])
}

model Package {
  id                   String    @id @default(cuid())
  beatId               String    @unique
  beat                 Beat      @relation(fields: [beatId], references: [id], onDelete: Cascade)
  titleOptions         String
  selectedTitle        String
  description          String
  tags                 String
  hashtags             String
  pinnedComment        String
  thumbnailPath        String    @default("")
  thumbnailConfig      String    @default("")
  videoPath            String    @default("")
  videoStatus          String    @default("none")
  videoError           String    @default("")
  youtubeVideoId       String    @default("")
  uploadStatus         String    @default("none")
  uploadError          String    @default("")
  youtubePrivacyStatus String    @default("private")
  youtubeMadeForKids   Boolean   @default(false)
  viewCount            Int       @default(0)
  likeCount            Int       @default(0)
  commentCount         Int       @default(0)
  statsUpdatedAt       DateTime?
  scheduledAt          DateTime?
  status               String    @default("draft")
  createdAt            DateTime  @default(now())

  @@index([scheduledAt])
  @@index([status])
}
