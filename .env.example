# Local development (SQLite). Copy this file to `.env`.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Production Neon PostgreSQL (set in the deployment secret store, not `.env`).
# DATABASE_URL: pooled URL; its hostname contains `-pooler`.
# DATABASE_URL="postgresql://ROLE:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# DIRECT_URL: direct URL for Prisma migrations; its hostname does not contain `-pooler`.
# DIRECT_URL="postgresql://ROLE:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional integrations
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# RESEND_API_KEY=""
# EMAIL_FROM="TypeBeatOS <no-reply@example.com>"
# AI metadata + SEO template generation. Set ONE of these (Gemini is checked
# first). Gemini has a free tier (aistudio.google.com); Anthropic is pay-per-use.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"        # optional override
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"  # optional override
