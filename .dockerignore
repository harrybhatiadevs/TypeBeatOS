# Local dev state — never goes into a prod image
.env
.env.local
.env.development
.env.development.local
prisma/dev.db*
dev.db*
uploads
/tmp

# Filled infra manifests carry real secrets (gitignored working copies) —
# keep them out of the build context entirely.
*.filled.yaml
containerapp*.filled.yaml

# Editor / OS junk
.DS_Store
*.swp

# Test + docs are not needed at runtime
coverage
docs
*.md
!README.md

# Local-only helpers
start-beta.sh
stop-beta.sh
